# CentralAIHub read-only integrations
# Copy to .env.integrations locally.
# NEVER commit the real file.

# Supabase Management API
# Prefer a fine-grained token with read-only permissions where available.
SUPABASE_ACCESS_TOKEN=

# Render public API
# Render API keys are broader credentials, so the adapter itself exposes GET-only routes.
RENDER_API_KEY=
