# CentralAIHub example environment
# Copy to .env locally only.
# NEVER commit a real .env file.
#
# Recommended: run scripts/bootstrap-env.ps1 to create .env
# with random local secrets.

# ---------------------------
# Local model server
# ---------------------------
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_HOST_URL=http://127.0.0.1:1234/v1

# If LM Studio authentication is disabled, this placeholder is sufficient
# for Open WebUI's OpenAI-compatible connection.
# If LM Studio authentication is enabled, replace this locally with its token.
LM_STUDIO_API_KEY=lm-studio

# ---------------------------
# Open WebUI
# ---------------------------
OPEN_WEBUI_HOST_PORT=3000
WEBUI_SECRET_KEY=CHANGE_ME_WITH_RANDOM_64_HEX

# ---------------------------
# SearXNG
# ---------------------------
SEARXNG_HOST_PORT=8081
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=CHANGE_ME_WITH_RANDOM_64_HEX

# ---------------------------
# Future integration adapters
# Leave blank until each integration is intentionally configured.
# ---------------------------

# GITHUB_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RENDER_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# OPENAI_API_KEY=

# Never place production secrets in this example file.
